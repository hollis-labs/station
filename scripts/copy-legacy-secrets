#!/usr/bin/env bash
# Copy provider keys from the legacy Secret Service location to the location the Substrate secrets
# module reads, one key at a time, without printing, logging or putting a value in an argument,
# a variable or the environment. The value travels only through a pipe:
#
#   secret-tool lookup  ->  <unit> secret set <ref>
#
# The legacy entry is read, never changed or deleted, so it stays as the rollback.
#
#   scripts/copy-legacy-secrets UNIT keychain://<namespace>/<key> [keychain://...]...
#
# For a reference keychain://<ns>/<key> the legacy entry is service "tether" (COPY_LEGACY_SERVICE),
# account "provider-api-key:<ns>/<key>"; the new entry is service "hollis-labs", account "<ns>/<key>",
# written by the unit's own `secret set` so the unit's resolver reads it back. After each copy the
# script runs `secret check` and compares the byte count with the legacy value's. An entry that already
# resolves in the new location is left alone unless COPY_OVERWRITE=1.
#
# Environment (all required, nothing is read from arguments):
#   COPY_BIN           the unit's binary
#   SUBSTRATE_CONFIG   the unit's config file
#   COPY_DATA_DIR      the unit's data directory, absolute (exported as the variable the binary reads, as
#                      scripts/first-run does; without it the binary would use the live directory)
# Optional: COPY_LEGACY_SERVICE (default tether), COPY_OVERWRITE=1.
# Exit status is non-zero if any reference could not be copied and verified.
set -euo pipefail
set +x

unit="${1:-}"
[ "$#" -ge 2 ] || { echo "usage: scripts/copy-legacy-secrets avatar-station|design-station|llm-gateway|usage-monitor REF..." >&2; exit 2; }
shift
case "$unit" in
  avatar-station|design-station) data_env=STATION_DATA_DIR ;;
  llm-gateway) data_env=LLM_GATEWAY_DATA_DIR ;;
  usage-monitor) data_env=USAGE_MONITOR_DATA_DIR ;;
  *) echo "unknown unit: $unit" >&2; exit 2 ;;
esac
for v in COPY_BIN SUBSTRATE_CONFIG COPY_DATA_DIR; do
  [ -n "${!v:-}" ] || { echo "$v is required" >&2; exit 2; }
done
case "$COPY_DATA_DIR" in /*) ;; *) echo "COPY_DATA_DIR must be absolute" >&2; exit 2 ;; esac
command -v secret-tool >/dev/null || { echo "secret-tool is required" >&2; exit 2; }
export "$data_env=$COPY_DATA_DIR"
legacy="${COPY_LEGACY_SERVICE:-tether}"

failed=0
for ref in "$@"; do
  case "$ref" in
    keychain://*/*) path="${ref#keychain://}" ;;
    *) echo "$ref: not a keychain://<namespace>/<key> reference" >&2; failed=1; continue ;;
  esac
  account="provider-api-key:$path"
  # a missing entry makes secret-tool fail; under pipefail that must not end the script here
  want=$( { secret-tool lookup service "$legacy" username "$account" 2>/dev/null || true; } | tr -d '\r\n' | wc -c)
  if [ "$want" -eq 0 ]; then
    echo "$ref: no legacy entry (service $legacy), nothing copied" >&2; failed=1; continue
  fi
  if [ "${COPY_OVERWRITE:-}" != 1 ] && "$COPY_BIN" secret check "$ref" 2>/dev/null | grep -q 'source keychain,'; then
    echo "$ref: already present in the new location, left alone"; continue
  fi
  if ! secret-tool lookup service "$legacy" username "$account" 2>/dev/null | "$COPY_BIN" secret set "$ref" >/dev/null; then
    echo "$ref: copy failed" >&2; failed=1; continue
  fi
  got=$("$COPY_BIN" secret check "$ref" 2>&1 | sed -n 's/.*(source keychain, \([0-9]*\) bytes).*/\1/p')
  if [ "$got" = "$want" ]; then
    echo "$ref: copied and verified ($got bytes), legacy entry kept"
  else
    echo "$ref: copied but the check says '${got:-no result}' bytes, legacy has $want" >&2; failed=1
  fi
done
exit "$failed"
